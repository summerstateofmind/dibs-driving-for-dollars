# Required
ANTHROPIC_API_KEY=sk-ant-...
AIRTABLE_PAT=pat...
AIRTABLE_BASE_ID=appXXXXXXXX
MY_PHONE_NUMBER=+1XXXXXXXXXX

# Twilio (for SMS path)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Tracerfy (for skip tracing)
TRACERFY_API_KEY=

# Telegram (alternative to Twilio)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random string (letters, digits, _ and - only). Telegram sends it back with every
# webhook call; /telegram rejects everything until this AND TELEGRAM_CHAT_ID are set.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Public https origin of your deployment (no trailing path). Used to verify Twilio
# signatures behind a proxy and by scripts/set_telegram_webhook.py.
PUBLIC_BASE_URL=https://your-app.up.railway.app

# Auto-email — pick ONE backend:
# Resend (required on Railway/PaaS that block SMTP)
RESEND_API_KEY=re_xxxx
# Gmail SMTP (works on VPS where SMTP isn't blocked)
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# Sender address (required for both)
SMTP_EMAIL=hello@yourdomain.com

# Scheduler
DIGEST_HOUR=8
DIGEST_TIMEZONE=America/Los_Angeles
# Sent as an X-Cron-Secret header to /cron/daily. Endpoint is disabled while empty.
CRON_SECRET=
AUTO_EMAIL_ENABLED=false
YOUR_NAME=Your Name
