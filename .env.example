# Required
ANTHROPIC_API_KEY=sk-ant-...
AIRTABLE_PAT=pat...
AIRTABLE_BASE_ID=appXXXXXXXX
MY_PHONE_NUMBER=+1XXXXXXXXXX

# Twilio (for SMS path)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Tracerfy (for skip tracing)
TRACERFY_API_KEY=

# Telegram (alternative to Twilio)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Auto-email — pick ONE backend:
# SendGrid (required on Railway/PaaS that block SMTP)
SENDGRID_API_KEY=SG.xxxx
# Gmail SMTP (works on VPS where SMTP isn't blocked)
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# Shared (required for both)
SMTP_EMAIL=your.email@gmail.com

# Scheduler
DIGEST_HOUR=8
DIGEST_TIMEZONE=America/Los_Angeles
CRON_SECRET=some-random-secret
AUTO_EMAIL_ENABLED=false
YOUR_NAME=Your Name
